; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Eromash Aventura"
config/description="Modo aventura de Eromash: mundo abierto 3D, fantasía nórdica."
run/main_scene="res://escenas/principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Calidad="*res://scripts/autoload/calidad.gd"
Controles="*res://scripts/autoload/controles.gd"
Juego="*res://scripts/autoload/juego.gd"
Captura="*res://scripts/autoload/captura.gd"
Sonido="*res://scripts/autoload/sonido.gd"
Seleccion="*res://scripts/autoload/seleccion.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2

[rendering]

occlusion_culling/use_occlusion_culling=true

anti_aliasing/quality/msaa_3d=1

[internationalization]

locale/translations=PackedStringArray("res://textos/textos.es.translation", "res://textos/textos.en.translation")

[shader_globals]

pos_heroe={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pos_camara={
"type": "vec3",
"value": Vector3(0, 30, 30)
}
